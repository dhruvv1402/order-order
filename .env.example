# Copy to .env and fill in. Never commit .env.
# Everything large (corpus, venv, caches, database volume) lives under this directory. It reaches a
# few gigabytes, so give it an absolute path on a drive with room rather than the default below.
ORDERORDER_DATA_DIR=data

# Database. Empty means SQLite inside ORDERORDER_DATA_DIR (metadata, citations, checkpoints; no vectors).
# Postgres with pgvector is needed for embeddings and hybrid search:
# DATABASE_URL=postgresql+psycopg://orderorder:orderorder@localhost:5432/orderorder
DATABASE_URL=

# Language models, as LangChain provider strings. Free tiers, see docs/TECH_STACK.md section 5.
# Primary handles demo data and bulk. Fallbacks are tried in order on rate limits or errors.
#
# Check the *daily* cap on a free tier before starting an evaluation, and not only the per-minute one.
# `--pace` spaces calls out across a minute and does nothing about a day. `gemini-3.6-flash` allows 20
# requests a day free, while `orderorder eval contrary --read 20` makes forty: it exhausts the quota
# partway and records every call after it as `unread`. That is the engine behaving correctly -- a
# provider failure is not a judgement about the texts -- but a report that is mostly `unread` is a
# quota failure and not a result. `orderorder doctor --probe` names the reason in a single call, so
# run it first when a report comes back emptier than the last one.
# `gemini-2.5-flash` was here and is retired: Google answers 404 for it on new keys and names
# `gemini-3.6-flash` as the replacement. It failed in the way that costs the most, because every
# model call degrades to "not assessed" by design, so a retired model reads as a corpus with nothing
# to say -- one evaluation run scored 100% abstention and mode 4 at 0/14 and looked like data.
LLM_PRIMARY=google_genai:gemini-3.6-flash
# `qwen3.5:4b` needs a newer ollama than 0.11.4, which refuses the pull with a 412 and a message
# about upgrading. `qwen3:4b` is 2.5 GB and works on it. Either way, set OLLAMA_MODELS *before*
# starting the server, or the pull lands wherever ollama defaults to on the system drive.
LLM_FALLBACKS=groq:openai/gpt-oss-120b,cerebras:gpt-oss-120b,ollama:qwen3:4b
# The only provider allowed for whole-judgment digests (needs a long context).
LLM_LONG_CONTEXT=google_genai:gemini-3.6-flash
# The only provider allowed for text that is not demo data (does not train on inputs).
LLM_SENSITIVE=groq:openai/gpt-oss-120b

# --- The agent -----------------------------------------------------------------------------------
#
# `orderorder agent` and POST /api/agent are a Strands agent over the eight checks in
# src/orderorder/agent/tools.py. It needs a model of its own, because it reasons in prose about which
# check to run, where every setting above is bound to an output schema.
#
# Bedrock first, when an AWS credential resolves -- the whole credential chain is consulted, not one
# variable, so a task role or `aws configure` works and nothing need be set here:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-west-2
#
# Without one it falls back to the first available provider from LLM_PRIMARY / LLM_FALLBACKS above,
# through LiteLLM, and says so in every answer it gives. That is a convenience for a laptop, not a
# deployment: check `orderorder agent --which` before recording anything, because an answer from the
# local 4B model and an answer from Bedrock are not the same answer and only this reports which.
#
# To force one and skip the choice -- either "bedrock:<model id>" or a provider string spelled the way
# LLM_PRIMARY spells it:
# AGENT_MODEL=bedrock:global.anthropic.claude-sonnet-4-6
# AGENT_MODEL=groq:openai/gpt-oss-120b
#
# The Bedrock model and region, used when AWS answers and AGENT_MODEL does not name something else.
# BEDROCK_MODEL=global.anthropic.claude-sonnet-4-6
# BEDROCK_REGION=us-west-2

# An OpenAI-compatible endpoint for `openai:` provider strings: a router or gateway, or the
# self-hosted SGLang/vLLM server in the production profile. Leave empty to talk to OpenAI itself.
# The model half of the provider string is whatever that endpoint calls the model:
#   LLM_PRIMARY=openai:qwen/qwen3-32b
# LLM_BASE_URL=https://example-router.invalid/api/v1
#
# A locally run gateway (OmniRoute, LiteLLM, or your own SGLang box) is the same three lines:
#   LLM_BASE_URL=http://localhost:20128/v1
#   LLM_PRIMARY=openai:<whatever that gateway calls the model>
#   OPENAI_API_KEY=<the gateway's own key>
# Then run `orderorder doctor --probe`. It makes one real call and reports whether a filled schema
# came back. Every model call in this engine is schema-bound, and an endpoint that accepts the
# request but answers in prose does not fail loudly: extent of support, weight and applicability all
# quietly become "not assessed". Check before trusting a route, and check again if it changes.

# Provider keys. Each team member creates their own.
GOOGLE_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=

# A free tier is per *account*, so a second key usually raises a daily ceiling further than a fifth
# provider does. Each SDK reads one fixed variable, so an entry in the chain can name its own with
# `#VARIABLE`, and that variable is part of its identity -- two accounts are two rungs of the chain
# rather than one deduped away:
#
#   LLM_FALLBACKS=google_genai:gemini-3.6-flash#GOOGLE_API_KEY_2,groq:openai/gpt-oss-120b
#
# Naming a provider's own default variable is the same as omitting it. Any variable not listed above
# needs no declaration here; it is read from the environment like the rest.
# GOOGLE_API_KEY_2=
# GROQ_API_KEY_2=
#
# What this does not buy: `with_fallbacks` retries the primary on *every* call, so an exhausted key
# costs one failed request per call for the remainder of a run. There is no cooldown. And a chain
# exhausted end to end degrades every check to "not assessed", which is a page of honest abstentions
# that reads exactly like a corpus with nothing to say -- so watch the abstention rate, and run
# `orderorder doctor --probe` before a long run rather than after it.

# Indian Kanoon API (lookup, fragments, cited-by). Apply for the non-commercial allowance.
INDIANKANOON_TOKEN=
INDIANKANOON_DAILY_QUOTA=200

# Embeddings. Empty base URL means encode locally with the static model, which is the measured
# baseline: ~4 minutes over the corpus, and dense retrieval off by default because at one vote it
# buys paraphrase recall and charges fragment recall (docs/ARCHITECTURE.md section 11.4).
#
# Set a base URL and any OpenAI-compatible /v1/embeddings endpoint does the encoding instead --
# Bitdeer's BAAI/bge-m3, a self-hosted Qwen3-Embedding, the TEI box in the production profile. This
# is the strong-encoder experiment the numbers have been pointing at, and it is cheap: the corpus
# measured 1.05 billion characters, roughly 263-300M tokens, about $3 at bge-m3 prices. The 8.3-hour
# CPU run it replaces was never worth starting.
#
# The index records which model wrote it and queries are encoded by that same model, so a corpus
# embedded through the endpoint is never queried by the local encoder. Re-embedding after a change of
# model is a rebuild, not a top-up.
# EMBEDDINGS_BASE_URL=https://api.example-inference.invalid/v1
# EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=BAAI/bge-m3

# Configured and unread: nothing in the engine reranks (docs/TECH_STACK.md section 8.1).
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
OLLAMA_MODELS=data/ollama

# Tracing: LangSmith Developer plan during the hackathon (demo data only).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=orderorder

# Tooling caches. uv and huggingface read these from the environment rather than from this file,
# so `scripts/dev-env.sh` (or `dev-env.ps1`) is what sets them, all under ORDERORDER_DATA_DIR:
#   UV_CACHE_DIR, UV_PYTHON_INSTALL_DIR, UV_PROJECT_ENVIRONMENT, HF_HOME
